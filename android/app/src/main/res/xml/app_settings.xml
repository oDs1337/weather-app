<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_category_general">
        
        <ListPreference
            android:key="app_language"
            android:title="@string/settings_language_title"
            android:summary="@string/settings_language_summary"
            android:dialogTitle="@string/settings_language_dialog_title"
            android:entries="@array/language_names"
            android:entryValues="@array/language_codes"
            android:defaultValue="en" />
            
    </PreferenceCategory>

</PreferenceScreen>
